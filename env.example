# Copy this to .env (local) ya Railway Variables me daalo

# BotFather se mila token
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bot ke OWNER ki Telegram user ID (tumhari apni ID)
# Ye kisi ka use NAHI rokti - sirf tumhe har job ki report DM me aati hai
# aur tum /stats chala sakte ho. Comma se ek se zyada bhi de sakte ho.
# Apni ID jaanne ke liye Telegram pe @userinfobot ko message karo.
ADMIN_IDS=123456789

# Optional: stats file ka path
STATS_FILE=stats.json
